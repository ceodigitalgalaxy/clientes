# Painel da agência · configuração local (só no computador da agência)
# Copie este arquivo para admin/.env (que NUNCA vai para o GitHub) e preencha.
# Usado pelos comandos admin/equipe.mjs (criar usuários) e admin/verify.mjs.
# O painel publicado NÃO usa este arquivo: ele entra com usuário e senha.

# Endereço do projeto no Supabase (Project Settings → Data API)
SUPABASE_URL=https://peieimwpkrattuldmjux.supabase.co

# Chave SECRETA do projeto (Project Settings → API Keys → Secret keys, começa
# com "sb_secret_"). Ela ignora as regras de acesso do banco: guarde só aqui,
# nunca no navegador, no site publicado ou no GitHub.
SUPABASE_SECRET_KEY=

# Porta da prévia local (opcional). Abre em http://localhost:5600/admin/
ADMIN_PORT=5600
